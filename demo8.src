// Демонстрация всех ключевых возможностей Sprint 7/8
// Возвращает код: 0 – успех, иначе – ошибка или сумма проверок

// Глобальный массив (инициализирован)
int global_arr[5] = {1, 2, 3, 4, 5};

// Внешние функции (для вывода, опционально)
// extern fn printf(char* fmt, ...);

fn main() -> int {
    // 1. Работа с массивом через указатель
    int* ptr = &global_arr[0];
    int sum = 0;
    int i = 0;
    while (i < 5) {
        sum = sum + *ptr;
        ptr = ptr + 1;   // сдвиг указателя
        i = i + 1;
    }
    // Ожидаемая сумма: 1+2+3+4+5 = 15

    // 2. Указатели и разыменование (дополнительно)
    int x = 42;
    int* p = &x;
    int y = *p;
    // y == 42, добавим к сумме для проверки
    sum = sum + y;   // 15 + 42 = 57

    // 3. Беззнаковое сравнение
    unsigned int u = 4000000000;
    unsigned int v = 3000000000;
    int unsigned_ok = 0;
    if (u > v) {
        unsigned_ok = 1;
    } else {
        unsigned_ok = 0;
    }
    sum = sum + unsigned_ok;   // 57 + 1 = 58

    // 4. Короткое замыкание && (деление на ноль не происходит)
    int a = 0;
    int b = 10;
    int short_circuit_ok = 0;
    if (a != 0 && (b / a) > 5) {
        short_circuit_ok = 0;  // не должно быть выполнено
    } else {
        short_circuit_ok = 1;  // будет выполнено
    }
    sum = sum + short_circuit_ok;   // 58 + 1 = 59

    // 5. Оптимизация: сворачивание констант (на ассемблере должно быть 30, а не вычисление)
    int folded = 10 + 20;   // должно стать 30
    sum = sum + folded;     // 59 + 30 = 89

    // 6. (Опционально) Вывод результата через printf (если доступен)
    // printf("Result sum: %d\n", sum);

    // Возвращаем сумму как код завершения (для проверки)
    return sum;   // ожидаем 89
}