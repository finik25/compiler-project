function main: int ()
  entry:
    t1 = MOVE 10
    t2 = MOVE 20
    t3 = MOVE 0
    # if binary at 5:9
BR_GT t1, 5
    JUMP else2
  then1:
    # if binary at 6:13
BR_LT t2, 30
    JUMP else5
  then4:
    t3 = MOVE 100
    JUMP endif6
  else5:
    t3 = MOVE 200
    JUMP endif6
  endif6:
    JUMP endif3
  else2:
    t3 = MOVE 0
    JUMP endif3
  endif3:
    RETURN t3
