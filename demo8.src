// Демонстрация: глобальный массив, указатели, unsigned, short-circuit, constant folding
int global_arr[5];

fn main() -> int {
    // Инициализируем массив вручную
    global_arr[0] = 1;
    global_arr[1] = 2;
    global_arr[2] = 3;
    global_arr[3] = 4;
    global_arr[4] = 5;

    int* ptr = &global_arr[0];
    int sum = 0;
    int i = 0;
    while (i < 5) {
        sum = sum + *ptr;
        ptr = ptr + 1;
        i = i + 1;
    }
    int x = 42;
    int* p = &x;
    sum = sum + *p;
    unsigned int u = 4000000000;
    unsigned int v = 3000000000;
    if (u > v) sum = sum + 1;
    int a = 0;
    int b = 10;
    if (a != 0 && (b / a) > 5) {} else { sum = sum + 1; }
    sum = sum + (10 + 20);   // constant folding
    return sum;   // 15+42+1+1+30 = 89
}